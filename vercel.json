{
  "rewrites": [
    { "source": "/get/m3u/:user",     "destination": "/api/m3u?user=:user" },
    { "source": "/play/:user/:sid",   "destination": "/api/m3u?user=:user&stream=true&sid=:sid" },
    { "source": "/stream",            "destination": "/api/m3u" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, User-Agent" },
        { "key": "X-Powered-By",                 "value": "MITV OmniEngine v6.0" }
      ]
    }
  ]
}
